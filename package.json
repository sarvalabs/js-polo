{
  "name": "js-polo",
  "version": "0.2.0",
  "description": "js-polo is the JS/TS implementation of the POLO Serialization Format.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "jest --env=node --colors --coverage --collectCoverageFrom='src/**/*.ts'",
    "lint": "eslint src/**/*.ts __tests__/**/*.ts",
    "build": "node scripts/build.cjs",
    "benchmark": "node --experimental-specifier-resolution=node --loader ts-node/esm __benchmarks__/*.ts",
    "test:package": "node scripts/smoke.cjs && node scripts/smoke.mjs",
    "vectors": "cd scripts/gen-vectors && go run . > ../../__tests__/vectors/go-polo.json"
  },
  "homepage": "https://docs.moi.technology/docs/build/packages/js-polo",
  "repository": {
    "type": "git",
    "url": "git://github.com/sarvalabs/js-polo.git"
  },
  "bugs": {
    "url": "https://github.com/sarvalabs/js-polo/issues"
  },
  "keywords": [
    "polo",
    "binary",
    "serializer",
    "deserializer"
  ],
  "author": "Sarva Labs Inc. & MOI Protocol Developers",
  "license": "Apache-2.0 OR MIT",
  "dependencies": {
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/jest": "^28.1.3",
    "@types/node": "^18.11.9",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "benchmark": "^2.1.4",
    "chance": "^1.1.9",
    "eslint": "^8.30.0",
    "jest": "^28.1.3",
    "jsdoc": "^4.0.5",
    "ts-jest": "^28.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.3"
  }
}
